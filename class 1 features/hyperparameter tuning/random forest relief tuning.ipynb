    "    f1 = f1_score(Y, y_pred)\n",
    "    f1_scores_plot.append(f1)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(thresholds, f1_scores_plot, color='blue', lw=2)\n",
